<?xml version="1.0" encoding="utf-8"?>
<!--
    SII-54: backup_rules.xml (API 26-30, fullBackupContent).

    server_url (in com.ksiig.tmuxmobile_preferences.xml) is included
    deliberately so it survives reinstall; it must NOT be removed.

    The root and database entries below are currently INERT because
    the only <include> is "sharedpref". They are forward-proofing so
    widening the include set later cannot silently start backing up
    cookies, WebView data, or credentials.db.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="tmux_mobile_secure.xml" />
    <exclude domain="root" path="app_webview/Cookies" />
    <exclude domain="root" path="app_webview/Default/Cookies" />
    <exclude domain="database" path="credentials.db" />
</full-backup-content>
